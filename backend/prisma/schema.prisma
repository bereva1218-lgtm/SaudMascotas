// Prisma schema for pet health backend

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  name     String
  role     String   @default("cuidador")
  pets     Pet[]
}

model Pet {
  id        Int       @id @default(autoincrement())
  name      String
  // nombre en minúsculas y sin espacios en los extremos; garantiza unicidad por dueño
  normalizedName String
  breed     String
  age       Int
  weight    Int
  avatar    String
  condition String?
  status    String
  owner     User?     @relation(fields: [ownerId], references: [id])
  ownerId   Int?
  logs      DailyLog[]
  alerts    Alert[]
  purchases Purchase[]
  vaccines    Vaccine[]
  medications Medication[]

  @@unique([ownerId, normalizedName])
}

model DailyLog {
  id         Int    @id @default(autoincrement())
  pet        Pet    @relation(fields: [petId], references: [id])
  petId      Int
  date       String
  appetite   Int
  energy     Int
  mood       Int
  waterIntake Int
  sleep      Int
  mobility   Int
  notes      String
  images     String

  // un solo registro por mascota y día (fecha "YYYY-MM-DD" en America/Bogota)
  @@unique([petId, date])
}

model Alert {
  id        Int    @id @default(autoincrement())
  pet       Pet    @relation(fields: [petId], references: [id])
  petId     Int
  type      String
  // explicación ("el porqué") basada en los registros
  message   String
  // fecha ISO en que se detectó por primera vez
  date      String
  read      Boolean @default(false)
  // métrica del registro diario afectada (appetite, energy, ...); null en alertas antiguas
  metric         String?
  // "precaucion" | "alerta"
  level          String?
  recommendation String?
  // promedio habitual de la mascota en esa métrica al detectar el descenso
  baseline       Float?
  // "active" | "resolved"; solo puede haber una activa por mascota y métrica
  status         String  @default("active")
  updatedAt      String?
  resolvedAt     String?

  @@index([petId, metric, status])
}

// Artículos comprados para una mascota (sección "Compras")
model Purchase {
  id           Int     @id @default(autoincrement())
  pet          Pet     @relation(fields: [petId], references: [id])
  petId        Int
  itemName     String
  // juguetes | collar | vestimenta | comida | accesorios | higiene | otro
  category     String
  // fecha de compra "YYYY-MM-DD"
  purchaseDate String
  // precio en pesos colombianos (sin decimales); opcional
  price        Int?
  notes        String?
  // fotos opcionales: JSON con imágenes comprimidas (data URL), máximo 3
  images       String  @default("[]")
  createdAt    String

  @@index([petId, purchaseDate])
}

// Vacunas aplicadas (historial) y fecha del próximo refuerzo
model Vaccine {
  id           Int     @id @default(autoincrement())
  pet          Pet     @relation(fields: [petId], references: [id])
  petId        Int
  name         String
  // "YYYY-MM-DD"
  appliedDate  String
  // próxima dosis o refuerzo "YYYY-MM-DD"; opcional
  nextDoseDate String?
  clinic       String?
  notes        String?
  createdAt    String

  @@index([petId, appliedDate])
}

// Tratamiento con medicamento: dosis cada `frequencyHours` desde `startAt` hasta `endDate`
model Medication {
  id             Int     @id @default(autoincrement())
  pet            Pet     @relation(fields: [petId], references: [id])
  petId          Int
  name           String
  // p. ej. "1 tableta", "5 ml"
  dose           String
  frequencyHours Int
  // fecha y hora (ISO, UTC) de la primera dosis
  startAt        String
  // último día del tratamiento "YYYY-MM-DD" (hora de Colombia)
  endDate        String
  notes          String?
  createdAt      String
  doses          MedicationDose[]

  @@index([petId])
}

// Dosis marcada como administrada
model MedicationDose {
  id             Int        @id @default(autoincrement())
  medication     Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  medicationId   Int
  // hora programada de la dosis (ISO, UTC)
  scheduledAt    String
  administeredAt String

  @@unique([medicationId, scheduledAt])
}
