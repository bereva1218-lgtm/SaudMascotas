# Copia este archivo como backend/.env y completa los valores.
# backend/.env está en .gitignore: nunca se sube al repositorio.

# Clave de OpenAI para el chat y las recomendaciones con IA.
# Créala en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-tu-clave-aqui

# Base de datos SQLite (ruta relativa a backend/prisma)
DATABASE_URL=file:./dev.db

# Secreto para firmar las sesiones (en Docker lo reemplaza docker-compose.yml)
JWT_SECRET=cambia-este-secreto

PORT=4000
